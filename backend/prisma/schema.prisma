// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  password                String
  name                    String
  avatar                  String?
  isTwoFactorEnabled      Boolean   @default(false)
  twoFactorSecret         String?
  twoFactorRecoveryCodes  String[]
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Relations
  organizationMemberships OrganizationMember[]
  createdBoards           Board[]              @relation("BoardCreator")
  comments                Comment[]
  attachments             Attachment[]
  timeEntries             TimeEntry[]
  notifications           Notification[]
  teamMemberships         TeamMember[]
  createdWorkdocs         Workdoc[]            @relation("WorkdocCreator")
  activityLogs            ActivityLog[]

  @@map("users")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  members      OrganizationMember[]
  boards       Board[]
  dashboards   Dashboard[]
  teams        Team[]
  workdocs     Workdoc[]
  whiteboards  Whiteboard[]
  documents    Document[]
  folders      Folder[]

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           String           // OWNER, ADMIN, MEMBER, VIEWER

  // Relations
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_members")
}

model Board {
  id             String   @id @default(cuid())
  name           String
  description    String?
  organizationId String
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator        User              @relation("BoardCreator", fields: [createdById], references: [id])
  groups         Group[]
  columns        Column[]
  items          Item[]
  automations    Automation[]
  teams          BoardTeam[]
  guestAccesses  GuestAccess[]
  recurringTasks RecurringTask[]
  permissions    BoardPermission[]

  @@index([organizationId])
  @@index([createdById])
  @@index([updatedAt])
  @@map("boards")
}

model BoardPermission {
  id        String   @id @default(cuid())
  boardId   String
  userId    String?
  teamId    String?
  role      String   // OWNER, ADMIN, EDITOR, COMMENTER, VIEWER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  team  Team?  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@unique([boardId, teamId])
  @@index([boardId])
  @@index([userId])
  @@index([teamId])
  @@map("board_permissions")
}

model Group {
  id        String   @id @default(cuid())
  boardId   String
  title     String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  items     Item[]

  @@index([boardId])
  @@index([position])
  @@map("groups")
}

model Item {
  id        String   @id @default(cuid())
  boardId   String
  groupId   String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  board         Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  group         Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  columnValues  ColumnValue[]
  comments      Comment[]     @relation("ItemComments")
  attachments   Attachment[]
  timeEntries   TimeEntry[]
  reactions     Reaction[]
  parentId      String?
  parent        Item?         @relation("Subitems", fields: [parentId], references: [id], onDelete: Cascade)
  subitems      Item[]        @relation("Subitems")
  dependencies  ItemDependency[] @relation("ItemDependencies")
  dependedOnBy  ItemDependency[] @relation("DependsOnItems")

  @@index([boardId])
  @@index([groupId])
  @@index([position])
  @@index([parentId])
  @@index([updatedAt])
  @@map("items")
}

model Column {
  id        String   @id @default(cuid())
  boardId   String
  title     String
  type      String   // STATUS, TEXT, NUMBER, DATE, etc.
  position  Int      @default(0)
  settings  Json?    @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  board        Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  columnValues ColumnValue[]

  @@index([boardId])
  @@index([position])
  @@map("columns")
}

model ColumnValue {
  id        String   @id @default(cuid())
  itemId    String
  columnId  String
  value     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  column Column  @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@unique([itemId, columnId])
  @@index([itemId])
  @@index([columnId])
  @@map("column_values")
}

model Comment {
  id        String   @id @default(cuid())
  itemId    String
  userId    String
  text      String
  parentId  String?
  mentions  String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  item      Item       @relation("ItemComments", fields: [itemId], references: [id], onDelete: Cascade)
  parent    Comment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]  @relation("CommentReplies")
  user      User       @relation(fields: [userId], references: [id])
  reactions Reaction[]

  @@index([itemId])
  @@index([userId])
  @@index([parentId])
  @@index([createdAt])
  @@map("comments")
}

model Reaction {
  id        String   @id @default(cuid())
  commentId String?
  itemId    String?
  userId    String
  emoji     String   // 👍, ❤️, 😊, etc.
  createdAt DateTime @default(now())

  // Relations
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  item    Item?    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@unique([itemId, userId, emoji])
  @@index([commentId])
  @@index([itemId])
  @@index([userId])
  @@map("reactions")
}

model Attachment {
  id        String   @id @default(cuid())
  itemId    String
  userId    String
  filename  String
  filepath  String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  // Relations
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([itemId])
  @@index([userId])
  @@map("attachments")
}

model Automation {
  id        String   @id @default(cuid())
  boardId   String
  name      String
  trigger   Json
  actions   Json
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
  @@index([enabled])
  @@map("automations")
}

model Dashboard {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  widgets      Widget[]

  @@index([organizationId])
  @@map("dashboards")
}

model Widget {
  id          String   @id @default(cuid())
  dashboardId String
  type        String   // NUMBERS, CHART, CLOCK, BOARD, TEXT
  title       String
  position    Json     // { x, y, w, h }
  config      Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@map("widgets")
}

model TimeEntry {
  id          String    @id @default(cuid())
  itemId      String
  userId      String
  startTime   DateTime
  endTime     DateTime?
  duration    Int?      // in seconds
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([itemId])
  @@index([userId])
  @@index([startTime])
  @@map("time_entries")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

model Team {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        TeamMember[]
  boards         BoardTeam[]
  permissions    BoardPermission[]

  @@index([organizationId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      String   // OWNER, ADMIN, MEMBER
  createdAt DateTime @default(now())

  // Relations
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model BoardTeam {
  id        String   @id @default(cuid())
  boardId   String
  teamId    String
  access    String   // VIEW, EDIT, ADMIN
  createdAt DateTime @default(now())

  // Relations
  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([boardId, teamId])
  @@index([boardId])
  @@index([teamId])
  @@map("board_teams")
}

model Workdoc {
  id             String   @id @default(cuid())
  title          String
  content        String   @db.Text
  organizationId String
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User         @relation("WorkdocCreator", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([createdById])
  @@index([updatedAt])
  @@map("workdocs")
}

model IntegrationConfig {
  id             String   @id @default(cuid())
  boardId        String?
  organizationId String
  type           String   // 'slack', 'teams', 'zapier', etc.
  webhookUrl     String
  enabled        Boolean  @default(true)
  events         String[] @default([]) // Events to trigger notifications
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([boardId])
  @@index([enabled])
  @@index([type])
  @@map("integration_configs")
}

model Form {
  id             String   @id @default(cuid())
  boardId        String
  groupId        String
  name           String
  description    String?
  fields         Json     // Form field definitions
  settings       Json     @default("{}")  // Form settings (thank you message, redirect, etc)
  isPublic       Boolean  @default(true)
  publicToken    String   @unique @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  submissions    FormSubmission[]

  @@index([boardId])
  @@index([groupId])
  @@index([publicToken])
  @@map("forms")
}

model FormSubmission {
  id           String   @id @default(cuid())
  formId       String
  itemId       String?  // Created item ID
  data         Json     // Submitted form data
  submitterEmail String?
  submitterName  String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  form         Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([itemId])
  @@index([createdAt])
  @@map("form_submissions")
}

model GuestAccess {
  id            String   @id @default(cuid())
  boardId       String
  token         String   @unique @default(cuid())
  email         String?
  name          String?
  accessLevel   String   // 'view', 'comment', 'edit'
  expiresAt     DateTime?
  isActive      Boolean  @default(true)
  createdById   String
  createdAt     DateTime @default(now())
  lastAccessedAt DateTime?
  accessCount   Int      @default(0)

  board         Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
  @@index([token])
  @@index([email])
  @@index([isActive])
  @@index([expiresAt])
  @@map("guest_accesses")
}

model ItemDependency {
  id            String   @id @default(cuid())
  itemId        String   // The dependent item
  dependsOnId   String   // The item it depends on
  type          String   // 'blocks', 'blocked_by', 'related_to'
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  item          Item     @relation("ItemDependencies", fields: [itemId], references: [id], onDelete: Cascade)
  dependsOn     Item     @relation("DependsOnItems", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([itemId, dependsOnId, type])
  @@index([itemId])
  @@index([dependsOnId])
  @@index([type])
  @@map("item_dependencies")
}

model RecurringTask {
  id              String   @id @default(cuid())
  boardId         String
  groupId         String
  itemTemplate    Json     // Template for creating items
  frequency       String   // 'daily', 'weekly', 'monthly', 'custom'
  interval        Int      @default(1) // Every N days/weeks/months
  daysOfWeek      Int[]    @default([]) // For weekly: 0=Sun, 1=Mon, etc.
  dayOfMonth      Int?     // For monthly: 1-31
  startDate       DateTime
  endDate         DateTime?
  nextRunDate     DateTime
  lastRunDate     DateTime?
  isActive        Boolean  @default(true)
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  board           Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
  @@index([nextRunDate])
  @@index([isActive])
  @@map("recurring_tasks")
}

model ActivityLog {
  id            String   @id @default(cuid())
  userId        String?
  organizationId String
  boardId       String?
  itemId        String?
  action        String   // 'create', 'update', 'delete', 'view', 'export'
  entityType    String   // 'board', 'item', 'column', 'user', 'group'
  entityId      String?
  changes       Json?    // Before/after data for updates
  ipAddress     String?
  userAgent     String?
  metadata      Json?    // Additional context
  createdAt     DateTime @default(now())

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
  @@index([boardId])
  @@index([itemId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@map("activity_logs")
}

model Whiteboard {
  id             String   @id @default(cuid())
  name           String
  content        Json     @default("{}")
  organizationId String
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([createdById])
  @@map("whiteboards")
}

model Document {
  id             String   @id @default(cuid())
  name           String
  filepath       String
  mimeType       String
  size           Int
  folderId       String?
  organizationId String
  createdById    String
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  folder         Folder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions       DocumentVersion[]

  @@index([organizationId])
  @@index([folderId])
  @@index([createdById])
  @@map("documents")
}

model Folder {
  id             String   @id @default(cuid())
  name           String
  parentId       String?
  organizationId String
  createdAt      DateTime @default(now())
  
  parent         Folder?      @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children       Folder[]     @relation("FolderHierarchy")
  documents      Document[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([parentId])
  @@map("folders")
}

model DocumentVersion {
  id           String   @id @default(cuid())
  documentId   String
  version      Int
  filepath     String
  size         Int
  createdById  String
  createdAt    DateTime @default(now())
  
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_versions")
}

